<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<AssemblyTitle>Estragonia</AssemblyTitle>
		<TargetFramework>net10.0</TargetFramework>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<AnalysisMode>Recommended</AnalysisMode>

		<IsPackable>true</IsPackable>
		<PackageId>Ouse.Estragonia</PackageId>
		<PackageReadmeFile>readme.md</PackageReadmeFile>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<Description>Bridge embedding Avalonia UI inside Godot 4 (Vulkan / Skia).</Description>
		<PackageTags>avalonia;godot;ui;game</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="GodotSharp" VersionOverride="4.7.1" />
		<PackageReference Include="Avalonia.Skia" />
		<PackageReference Include="Avalonia.HarfBuzz" />
		<!-- Avalonia 12: ISkiaGpu / related types are internal; required for the shared-VkImage path. -->
		<PackageReference Include="IgnoresAccessChecksToGenerator" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
		<IgnoresAccessChecksTo Include="Avalonia.Base" />
		<IgnoresAccessChecksTo Include="Avalonia.Skia" />
	</ItemGroup>

	<ItemGroup>
		<None Include="../../readme.md" Pack="true" PackagePath="/" Visible="false" />
	</ItemGroup>

	<!--
		Use Avalonia runtime assemblies (lib/) instead of ref/ assemblies.
		Ref assemblies hide platform interfaces needed by this embedding backend.
		See https://github.com/AvaloniaUI/Avalonia/pull/11062
	-->
	<Target
		Name="EstragoniaReferenceAvaloniaRuntimeAssemblies"
		AfterTargets="ResolvePackageAssets"
		BeforeTargets="ResolveLockFileReferences">

		<ItemGroup>
			<ResolvedCompileFileDefinitions
				Include="@(ResolvedCompileFileDefinitions->'%(Identity)'->Replace('/ref/', '/lib/')->Replace('\ref\', '\lib\'))"
				HintPath="$([System.String]::new('%(HintPath)').Replace('/ref/', '/lib/').Replace('\ref\', '\lib\'))"
				PathInPackage="lib/$([System.String]::new('%(PathInPackage)').Substring(4))"
				Condition="$([System.String]::new('%(PathInPackage)').StartsWith('ref/$(TargetFramework)/Avalonia'))" />

			<ResolvedCompileFileDefinitions
				Remove="@(ResolvedCompileFileDefinitions)"
				Condition="$([System.String]::new('%(PathInPackage)').StartsWith('ref/$(TargetFramework)/Avalonia'))" />
		</ItemGroup>

	</Target>

</Project>
