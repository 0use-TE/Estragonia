<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<PackageType>Template</PackageType>
		<PackageId>Ouse.Estragonia.Templates</PackageId>
		<Title>Estragonia templates</Title>
		<Description>dotnet new templates for Godot 4 + Avalonia (Ouse.Estragonia).</Description>
		<PackageTags>dotnet-new;templates;godot;avalonia;estragonia</PackageTags>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<Version>1.0.0</Version>
		<Authors>0use-TE; Julien Lebosquain</Authors>
		<TargetFramework>net10.0</TargetFramework>
		<IncludeContentInPack>true</IncludeContentInPack>
		<IncludeBuildOutput>false</IncludeBuildOutput>
		<ContentTargetFolders>content</ContentTargetFolders>
		<NoWarn>$(NoWarn);NU5128</NoWarn>
		<NoDefaultExcludes>true</NoDefaultExcludes>
		<SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
		<IsPackable>true</IsPackable>
	</PropertyGroup>

	<ItemGroup>
		<Content Include="estragonia-godot\**\*" Exclude="estragonia-godot\**\bin\**;estragonia-godot\**\obj\**;estragonia-godot\**\.godot\**" />
		<Compile Remove="**\*" />
		<None Include="README.md" Pack="true" PackagePath="/" />
	</ItemGroup>

</Project>
