<UserControl
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:vm="using:GodotGame.ViewModels"
	mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
	x:Class="GodotGame.Views.MainView"
	x:DataType="vm:MainViewModel">

	<Design.DataContext>
		<vm:MainViewModel />
	</Design.DataContext>

	<Border
		HorizontalAlignment="Left"
		VerticalAlignment="Top"
		Margin="24"
		Padding="20"
		CornerRadius="12"
		Background="#CC141820"
		BoxShadow="0 8 24 0 #66000000"
		MinWidth="320">

		<StackPanel Spacing="12">
			<TextBlock Text="{Binding Title}" FontSize="24" FontWeight="SemiBold" Foreground="#F0C070" />
			<TextBlock
				Text="Edit Views/MainView.axaml and ViewModels/MainViewModel.cs to build your UI."
				TextWrapping="Wrap"
				Opacity="0.75" />
			<Button Content="Say hello" Command="{Binding GreetCommand}" HorizontalAlignment="Left" />
			<TextBlock Text="{Binding Status}" Opacity="0.9" />
		</StackPanel>
	</Border>

</UserControl>
