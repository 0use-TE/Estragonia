<UserControl
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
	x:Class="HelloWorld.HelloWorldView">

	<StackPanel
		HorizontalAlignment="Stretch"
		VerticalAlignment="Center"
		Margin="16"
		Spacing="10">
		<Button Content="Avalonia Button" HorizontalAlignment="Stretch" Padding="12,8" />
		<TextBlock Text="Drag the Godot sprite where there is no UI" Opacity="0.75" TextWrapping="Wrap" />
		<Slider />
		<TabControl MinHeight="180">
			<TabItem Header="武器" />
			<TabItem Header="防具" />
			<TabItem Header="道具" />
			<TabItem Header="时装" />
		</TabControl>
	</StackPanel>

</UserControl>
