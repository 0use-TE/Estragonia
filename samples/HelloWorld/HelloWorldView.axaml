<UserControl
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
	x:Class="HelloWorld.HelloWorldView"
	TextOptions.TextRenderingMode="Antialias">

	<UserControl.Styles>

		<Style Selector="Border.anim">
			<Style.Animations>
				<Animation Duration="0:0:2" IterationCount="infinite" PlaybackDirection="Alternate">
					<KeyFrame Cue="0%">
						<Setter Property="Background" Value="#AAFF0000" />
					</KeyFrame>
					<KeyFrame Cue="100%">
						<Setter Property="Background" Value="#AA1E90FF" />
					</KeyFrame>
				</Animation>
			</Style.Animations>
		</Style>

	</UserControl.Styles>

	<Grid RowDefinitions="*,*">

		<Border
			BorderThickness="1"
			BorderBrush="DodgerBlue"
			CornerRadius="16"
			Classes="anim"
			VerticalAlignment="Top"
			Margin="100,100,100,0">

			<Grid ColumnDefinitions="Auto,*" HorizontalAlignment="Center">

				<Image
					Source="/Avalonia.png"
					Width="64"
					Height="64"
					VerticalAlignment="Center"
					Grid.Column="0" />

				<TextBlock
					Text="Hello from Avalonia in Godot!"
					VerticalAlignment="Center"
					TextTrimming="{x:Static TextTrimming.CharacterEllipsis}"
					Margin="8"
					FontSize="48"
					Foreground="Orange"
					Grid.Column="1" />

			</Grid>

		</Border>

		<StackPanel Grid.Row="1" Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center">
			<Button x:Name="ClickMeButton" Content="Click me" Padding="16,8" />
			<TextBlock x:Name="ClickStatus" Text="Button not clicked yet." FontSize="20" />
			<TextBox
				TextWrapping="Wrap"
				Width="200"
				Height="120"
				Text="Type here to test keyboard focus." />
		</StackPanel>

		<TextBlock
			x:Name="FpsCounter"
			Grid.Row="0"
			HorizontalAlignment="Left"
			VerticalAlignment="Top"
			FontSize="24"
			Foreground="Black" />

	</Grid>

</UserControl>
