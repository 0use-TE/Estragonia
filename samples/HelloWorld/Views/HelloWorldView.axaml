<UserControl
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:vm="using:HelloWorld.ViewModels"
	mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
	x:Class="HelloWorld.Views.HelloWorldView"
	x:DataType="vm:HelloWorldViewModel">

	<Design.DataContext>
		<vm:HelloWorldViewModel />
	</Design.DataContext>

<StackPanel Spacing="4">
	<TextBlock HorizontalAlignment="Center">Hello, World!</TextBlock>
	<Button>Ouse</Button>
	<TabControl Height="100">
		<TabItem Header="Ouse" ></TabItem>
		<TabItem Header="Another Tab"></TabItem>
	</TabControl>
	<TimePicker></TimePicker>
	<DatePicker></DatePicker>
	<Grid Height="200" Width="100" ColumnDefinitions="*,2,*">
		<Grid.Styles >
			<Style Selector="TextBlock">
				<Setter Property="FontSize" Value="20"></Setter>
			</Style>
		</Grid.Styles>
		<Panel Grid.Column="0" VerticalAlignment="Center">
			<TextBlock Text="1"></TextBlock>
		</Panel>
		<GridSplitter Grid.Column="1"></GridSplitter>
		<Panel Grid.Column="2">
			<TextBlock VerticalAlignment="Center"  Text="3"></TextBlock>
		</Panel>
	</Grid>
		<ItemsControl ItemsSource="{Binding Messages}"></ItemsControl>
</StackPanel>
</UserControl>
