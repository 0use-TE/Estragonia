<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HelloWorld.ViewModels.Pages"
             x:Class="HelloWorld.Views.Pages.BindingPage"
             x:DataType="vm:BindingViewModel">
	<StackPanel Spacing="12" MaxWidth="420" HorizontalAlignment="Left">
		<TextBlock Text="数据绑定" FontSize="22" FontWeight="SemiBold" />
		<TextBlock Opacity="0.75" Text="CommunityToolkit.Mvvm + ObservableCollection + RelayCommand" />

		<DockPanel>
			<Button DockPanel.Dock="Right"
			        Content="添加"
			        Margin="8,0,0,0"
			        Command="{Binding AddCommand}"
			        Classes="Accent" />
			<TextBox PlaceholderText="新物品"
			         Text="{Binding NewItem}" />
		</DockPanel>

		<ListBox ItemsSource="{Binding Items}"
		         SelectedItem="{Binding SelectedItem}"
		         MinHeight="180" />

		<Button Content="删除选中"
		        Command="{Binding RemoveSelectedCommand}"
		        HorizontalAlignment="Left" />
	</StackPanel>
</UserControl>
