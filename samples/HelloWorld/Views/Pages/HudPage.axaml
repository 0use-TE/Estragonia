<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HelloWorld.ViewModels.Pages"
             x:Class="HelloWorld.Views.Pages.HudPage"
             x:DataType="vm:HudViewModel">
	<Grid ColumnDefinitions="*,240" RowDefinitions="Auto,*">
		<Border Grid.ColumnSpan="2"
		        Background="#AA151820"
		        CornerRadius="10"
		        Padding="16"
		        Margin="0,0,0,12">
			<StackPanel Spacing="10">
				<DockPanel>
					<TextBlock Text="{Binding Wave, StringFormat=波次 {0}}" FontWeight="SemiBold" />
					<TextBlock DockPanel.Dock="Right"
					           HorizontalAlignment="Right"
					           Text="{Binding Gold, StringFormat=金币 {0}}" />
				</DockPanel>
				<StackPanel Spacing="4">
					<TextBlock Text="{Binding Hp, StringFormat=HP {0:0}/100}" />
					<ProgressBar Minimum="0" Maximum="100" Value="{Binding Hp}" Height="10" />
				</StackPanel>
				<StackPanel Spacing="4">
					<TextBlock Text="{Binding Mp, StringFormat=MP {0:0}/100}" />
					<ProgressBar Minimum="0" Maximum="100" Value="{Binding Mp}" Height="10" Classes="Success" />
				</StackPanel>
				<StackPanel Spacing="4">
					<TextBlock Text="{Binding Exp, StringFormat=EXP {0:0}%}" />
					<ProgressBar Minimum="0" Maximum="100" Value="{Binding Exp}" Height="8" />
				</StackPanel>
				<StackPanel Orientation="Horizontal" Spacing="8">
					<Button Content="受伤" Command="{Binding TakeDamageCommand}" />
					<Button Content="治疗" Command="{Binding HealCommand}" Classes="Accent" />
				</StackPanel>
			</StackPanel>
		</Border>

		<Border Grid.Row="1" Grid.Column="1"
		        Background="#991A1D23"
		        CornerRadius="10"
		        Padding="12">
			<DockPanel>
				<TextBlock DockPanel.Dock="Top" Text="战斗日志" FontWeight="SemiBold" Margin="0,0,0,8" />
				<ListBox ItemsSource="{Binding Log}" Background="Transparent" BorderThickness="0" />
			</DockPanel>
		</Border>
	</Grid>
</UserControl>
